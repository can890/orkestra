{
  "name": "@orkestra/orkestra-mobile",
  "version": "1.2.44",
  "private": true,
  "description": "Sovra Android istemcisi: Mac'teki Sovra çalışma alanına bağlanır, ajan sohbetlerini ve limitleri telefondan yönetir",
  "license": "Apache-2.0",
  "author": {
    "name": "Sovra Contributors"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "pnpm exec nx test @orkestra/orkestra-mobile",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src",
    "cap:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@orkestra/wire": "workspace:*",
    "capacitor-secure-storage-plugin": "^0.14.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^20.19.42",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "@vitejs/plugin-react": "^4.7.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "typescript": "^6.0.2",
    "vite": "^6.4.1",
    "vitest": "^4.1.0",
    "zod": "4.4.3"
  },
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec vitest run",
          "cwd": "apps/orkestra-mobile"
        }
      }
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_usage_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121318"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_usage_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sovra · Kullanım Limitleri"
        android:textColor="#9A9CA6"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_usage_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Kota bilgisi bekleniyor"
        android:textColor="#F4F5F8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/widget_usage_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0" />
</LinearLayout>

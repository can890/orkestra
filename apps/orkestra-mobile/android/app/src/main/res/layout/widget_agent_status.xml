<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_agent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121318"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_agent_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sovra · Ajan Durumu"
        android:textColor="#9A9CA6"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_agent_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tüm ajanlar boşta"
        android:textColor="#F4F5F8"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_agent_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Sovra'yı açmak için dokunun"
        android:textColor="#B4B6C2"
        android:textSize="12sp" />
</LinearLayout>

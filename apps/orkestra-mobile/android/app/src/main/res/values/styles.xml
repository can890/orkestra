<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#090A0D</item>
        <item name="colorPrimaryDark">#090A0D</item>
        <item name="colorAccent">#10B981</item>
        <item name="android:windowBackground">#090A0D</item>
        <item name="android:statusBarColor">#090A0D</item>
        <item name="android:navigationBarColor">#090A0D</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#090A0D</item>
        <item name="android:statusBarColor">#090A0D</item>
        <item name="android:navigationBarColor">#090A0D</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">#090A0D</item>
        <item name="android:statusBarColor">#090A0D</item>
        <item name="android:navigationBarColor">#090A0D</item>
        <item name="windowSplashScreenBackground">#090A0D</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>

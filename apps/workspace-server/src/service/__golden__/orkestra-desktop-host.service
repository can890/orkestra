[Unit]
Description=Orkestra headless desktop host
Documentation=https://github.com/can890/orkestra
StartLimitIntervalSec=300
StartLimitBurst=5
Wants=orkestra-workspace-server.service
After=orkestra-workspace-server.service

[Service]
Type=simple
WorkingDirectory=/home/selim
Environment=ORKESTRA_SERVICE_UNIT=orkestra-desktop-host.service
ExecStart=/home/selim/.orkestra/workspace-server/current/bin/orkestra-workspace-server service run --target desktop-host --app /opt/Orkestra/orkestra --display xvfb --xvfb-run /usr/bin/xvfb-run --workspace-socket /home/selim/.orkestra/workspace-server/run/workspace.sock
KillMode=mixed
TimeoutStopSec=90
OOMPolicy=continue
Restart=always
RestartSec=5
RestartPreventExitStatus=78
CPUWeight=1000
IOWeight=1000
MemoryLow=1G
MemoryMax=6G
OOMScoreAdjust=100
ManagedOOMPreference=avoid
StandardOutput=append:/home/selim/.orkestra/service/logs/orkestra-desktop-host.log
StandardError=append:/home/selim/.orkestra/service/logs/orkestra-desktop-host.log

[Install]
WantedBy=default.target

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.orkestra.desktop-host</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/selim/.orkestra/workspace-server/current/bin/orkestra-workspace-server</string>
    <string>service</string>
    <string>run</string>
    <string>--target</string>
    <string>desktop-host</string>
    <string>--app</string>
    <string>/Applications/Orkestra.app/Contents/MacOS/Orkestra</string>
    <string>--display</string>
    <string>existing</string>
  </array>
  <key>EnvironmentVariables</key>

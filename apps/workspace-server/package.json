{
  "name": "@orkestra/workspace-server",
  "version": "0.1.12",
  "private": true,
  "description": "Orkestra Workspace Server — runs as a daemon on remote machines and exposes workspace runtimes via wire",
  "license": "Apache-2.0",
  "author": {
    "name": "Orkestra Contributors"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "dev": "tsx --watch src/index.ts",
    "dev:remote": "tsx scripts/dev-remote.ts",
    "dev:remote-app": "ORKESTRA_WORKSPACE_SERVER_ARTIFACTS_URL=http://minio:9000/orkestra-releases/workspace-server ORKESTRA_WORKSPACE_SERVER_DEV_AUTO_UPDATE=1 pnpm --dir ../orkestra-desktop run dev",
    "package": "tsx scripts/package.ts",
    "package:dev": "ORKESTRA_WS_DEV_BUILD=1 tsx scripts/package.ts --target linux-arm64",
    "upload:dev": "ORKESTRA_WS_DEV_UPLOAD=1 ORKESTRA_WS_UPLOAD_ENDPOINT=http://localhost:9000/orkestra-releases ORKESTRA_WS_UPLOAD_ACCESS_KEY=minioadmin ORKESTRA_WS_UPLOAD_SECRET_KEY=minioadmin tsx scripts/upload-r2.ts",
    "upload:r2": "tsx scripts/upload-r2.ts",
    "run:docker-remote": "docker compose up --build -d minio minio-setup workspace-remote",
    "start": "node dist/index.mjs",
    "test": "pnpm exec nx test @orkestra/workspace-server",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@orkestra/core": "workspace:*",
    "@orkestra/plugins": "workspace:*",
    "@orkestra/shared": "workspace:*",
    "@orkestra/wire": "workspace:*",
    "@parcel/watcher": "2.5.6",
    "better-sqlite3": "12.10.0",
    "node-pty": "1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "s3mini": "^0.9.5",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.28.0"
  },
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec vitest run",
          "cwd": "apps/workspace-server"
        }
      }
    }
  }
}
